# Server Configuration
PORT=5000
NODE_ENV=development

# JWT Secret for Session Auth
JWT_SECRET=super_secret_jwt_key_codepath_placement_2025

# Supabase Configuration (Optional - falls back gracefully to in-memory database with full seed data)
SUPABASE_URL=https://your-supabase-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# PostgreSQL Connection String (Optional direct DB connection)
DATABASE_URL=postgresql://postgres:password@localhost:5432/codepath

# Judge0 API (Optional - for remote isolated multi-language code execution)
JUDGE0_API_KEY=
JUDGE0_HOST=https://judge0-ce.p.rapidapi.com

# AI Mentor (Optional - Google Gemini or OpenAI API key; falls back to smart contextual DSA mentor)
GEMINI_API_KEY=
OPENAI_API_KEY=
